# Application environment variables
# Copy this file to .env and adjust values for your local environment.
# Never commit real secrets.

APP_NAME=India Business Research & Decision Agent
APP_ENV=development
LOG_LEVEL=INFO

# Database (PostgreSQL in production; tests use SQLite)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ibrda

# Public Open-Meteo API base URLs (no API key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE_BASE_URL=https://archive-api.open-meteo.com/v1

# OpenStreetMap Nominatim
# Provide a descriptive User-Agent with contact info per Nominatim usage policy.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=IndiaBusinessResearchDecisionAgent/0.1 (contact@example.com)
NOMINATIM_MIN_REQUEST_INTERVAL_SECONDS=1.0
NOMINATIM_CACHE_TTL_SECONDS=86400

# Overpass (public OSM POI queries for competition agent)
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter

# India data.gov.in CKAN catalog (optional API key)
DATA_GOV_IN_BASE_URL=https://data.gov.in/api/3/action
DATA_GOV_IN_API_KEY=

# Shared HTTP / cache settings
HTTP_TIMEOUT_SECONDS=30
CACHE_TTL_SECONDS=600

# LLM / research planner
# local = deterministic structured provider (default MVP)
# bedrock = AWS Bedrock Converse (requires boto3 + credentials + BEDROCK_MODEL_ID)
LLM_PROVIDER=local
PLANNER_MAX_RETRIES=2
PLANNER_RETRY_BACKOFF_SECONDS=0.25
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.0
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=

# Evidence / provenance
EVIDENCE_MIN_CONFIDENCE=0.3
EVIDENCE_STALE_AFTER_HOURS=72
EVIDENCE_LOW_CONFIDENCE_AS_ERROR=false

# Opportunity scoring (weights are normalized at runtime)
SCORE_WEIGHT_DEMAND=0.25
SCORE_WEIGHT_COMPETITION=0.20
SCORE_WEIGHT_ACCESSIBILITY=0.15
SCORE_WEIGHT_INFRASTRUCTURE=0.15
SCORE_WEIGHT_MARKET_INDICATORS=0.15
SCORE_WEIGHT_RISK=0.10
SCORE_CRITICAL_DIMENSIONS=demand,competition,accessibility

# Critic / self-correction (research cycles before INSUFFICIENT DATA halt)
MAX_RESEARCH_ITERATIONS=3

# Document RAG (pgvector on PostgreSQL; SQLite stores JSON embeddings)
# RAG_EMBEDDING_DIM must match the Vector column size (64) after schema create
RAG_EMBEDDING_DIM=64
RAG_CHUNK_SIZE=420
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=5
RAG_SEED_ON_STARTUP=true

# Optional: enable live API integration tests
# RUN_INTEGRATION_TESTS=true
